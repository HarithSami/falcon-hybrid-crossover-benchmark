\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:crossover}{{1}{2}{7B 3-Architecture BF16 Crossover on Isolated NVIDIA L4 GPUs}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 7B Architectural Triad BF16 Crossover Benchmarks across Context Lengths ($N \in [512, 16384]$) on Isolated NVIDIA L4 GPUs. Top row: Prefill TTFT (ms), Decode Throughput (tokens/s), and Peak VRAM Footprint (MB). Bottom row: Dynamic State Growth (MB), Total Energy per Token (J/tok), and Dynamic Energy per Token (J/tok). Hybrid \texttt  {Falcon-H1-7B} reaches Peak VRAM parity with \texttt  {Falcon3-7B} at $N=2{,}048$ tokens and achieves a $1.67\,\text  {GB}$ memory reduction at $16\text  {K}$ context while maintaining context-invariant decode speed ($<1.5\%$ variation).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:crossover}{{1}{3}{7B Architectural Triad BF16 Crossover Benchmarks across Context Lengths ($N \in [512, 16384]$) on Isolated NVIDIA L4 GPUs. Top row: Prefill TTFT (ms), Decode Throughput (tokens/s), and Peak VRAM Footprint (MB). Bottom row: Dynamic State Growth (MB), Total Energy per Token (J/tok), and Dynamic Energy per Token (J/tok). Hybrid \texttt {Falcon-H1-7B} reaches Peak VRAM parity with \texttt {Falcon3-7B} at $N=2{,}048$ tokens and achieves a $1.67\,\text {GB}$ memory reduction at $16\text {K}$ context while maintaining context-invariant decode speed ($<1.5\%$ variation)}{figure.caption.2}{}}
