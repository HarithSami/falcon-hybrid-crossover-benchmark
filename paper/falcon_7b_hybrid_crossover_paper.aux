\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}\texttt  {vLLM} (CUDA Graphs) vs.\ \texttt  {hf\_eager}: Roofline MBU and Energy Crossover}{3}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Practical Systems Guidelines for Deploying Hybrid SSMs}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Quantization Fidelity, Memory, and Energy Ablation across the 7B Triad. Left to right: Static Weight Footprint (MB), Evaluation Perplexity Drift ($\Delta \text  {PPL}\% = \frac  {\mathrm  {PPL}_Q - \mathrm  {PPL}_{\mathrm  {bf16}}}{\mathrm  {PPL}_{\mathrm  {bf16}}} \times 100$), Token-Level Logit KL Divergence ($\mathrm  {KL}(P_{\mathrm  {bf16}} \parallel Q)$), Top-1 Output Agreement (\%), and Zero-Shot Task Accuracy (\%). Uniform 4-bit NormalFloat induces catastrophic accuracy loss on pure Mamba ($80\% \to 40\%$), whereas branch-aware mixed precision (\texttt  {int4\_mixed\_ssm}) on \texttt  {Falcon-H1-7B} compresses weights by $-53.5\%$ while preserving full $100\%$ zero-shot accuracy.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:quant}{{2}{4}{Quantization Fidelity, Memory, and Energy Ablation across the 7B Triad. Left to right: Static Weight Footprint (MB), Evaluation Perplexity Drift ($\Delta \text {PPL}\% = \frac {\mathrm {PPL}_Q - \mathrm {PPL}_{\mathrm {bf16}}}{\mathrm {PPL}_{\mathrm {bf16}}} \times 100$), Token-Level Logit KL Divergence ($\mathrm {KL}(P_{\mathrm {bf16}} \parallel Q)$), Top-1 Output Agreement (\%), and Zero-Shot Task Accuracy (\%). Uniform 4-bit NormalFloat induces catastrophic accuracy loss on pure Mamba ($80\% \to 40\%$), whereas branch-aware mixed precision (\texttt {int4\_mixed\_ssm}) on \texttt {Falcon-H1-7B} compresses weights by $-53.5\%$ while preserving full $100\%$ zero-shot accuracy}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \texttt  {vLLM} (CUDA Graphs) vs.\ \texttt  {hf\_eager} Roofline MFU/MBU and Energy Telemetry.}}{4}{table.caption.5}\protected@file@percent }
\newlabel{tab:vllm}{{3}{4}{\texttt {vLLM} (CUDA Graphs) vs.\ \texttt {hf\_eager} Roofline MFU/MBU and Energy Telemetry}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \texttt  {vLLM} (CUDA Graphs) vs.\ \texttt  {hf\_eager} Roofline Telemetry and Energy Crossover. Top row: Prefill TTFT (ms) and Decode Throughput (tokens/s). Bottom row: Total Energy per Token (J/tok), Achieved HBM Bandwidth (GB/s), and Model Bandwidth Utilization ($\mathrm  {MBU}\%$). Capturing CUDA Graphs in \texttt  {vLLM} unlocks $84.2\%\text  {--}91.1\%$ MBU on \texttt  {Falcon-H1-7B} and \texttt  {Falcon3-Mamba-7B}, eliminating kernel-launch stalls and driving a $2.36\times \text  {--}2.54\times $ throughput speedup that overtakes \texttt  {Falcon3-7B} at $N=8{,}192$.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:vllm}{{3}{4}{\texttt {vLLM} (CUDA Graphs) vs.\ \texttt {hf\_eager} Roofline Telemetry and Energy Crossover. Top row: Prefill TTFT (ms) and Decode Throughput (tokens/s). Bottom row: Total Energy per Token (J/tok), Achieved HBM Bandwidth (GB/s), and Model Bandwidth Utilization ($\mathrm {MBU}\%$). Capturing CUDA Graphs in \texttt {vLLM} unlocks $84.2\%\text {--}91.1\%$ MBU on \texttt {Falcon-H1-7B} and \texttt {Falcon3-Mamba-7B}, eliminating kernel-launch stalls and driving a $2.36\times \text {--}2.54\times $ throughput speedup that overtakes \texttt {Falcon3-7B} at $N=8{,}192$}{figure.caption.6}{}}
